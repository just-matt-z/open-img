<Window x:Class="OpenImage.Dialogs.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Artwork" 
        Height="400" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource ThemeBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Export Artwork" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="FORMAT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeTextTertiaryBrush}" Margin="0,0,0,6" />
            <Border Background="{StaticResource ThemeCardBrush}" CornerRadius="10" BorderBrush="{StaticResource ThemeHairlineBrush}" BorderThickness="0.5" Padding="6" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton x:Name="RbPng" Content="PNG (Lossless)" Style="{StaticResource IOS7SegmentedButtonStyle}" IsChecked="True" Margin="4,0" Checked="Format_Changed" />
                    <RadioButton x:Name="RbJpg" Content="JPEG" Style="{StaticResource IOS7SegmentedButtonStyle}" Margin="4,0" Checked="Format_Changed" />
                    <RadioButton x:Name="RbBmp" Content="BMP" Style="{StaticResource IOS7SegmentedButtonStyle}" Margin="4,0" Checked="Format_Changed" />
                </StackPanel>
            </Border>

            <TextBlock Text="SCALE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeTextTertiaryBrush}" Margin="0,0,0,6" />
            <Border Background="{StaticResource ThemeCardBrush}" CornerRadius="10" BorderBrush="{StaticResource ThemeHairlineBrush}" BorderThickness="0.5" Padding="6" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton x:Name="RbScaleHalf" Content="0.5x" Style="{StaticResource IOS7SegmentedButtonStyle}" Margin="4,0" Checked="Scale_Changed" />
                    <RadioButton x:Name="RbScale1" Content="1.0x" Style="{StaticResource IOS7SegmentedButtonStyle}" IsChecked="True" Margin="4,0" Checked="Scale_Changed" />
                    <RadioButton x:Name="RbScale2" Content="2.0x" Style="{StaticResource IOS7SegmentedButtonStyle}" Margin="4,0" Checked="Scale_Changed" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="QualityPanel" Visibility="Collapsed" Margin="0,0,0,16">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="JPEG QUALITY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeTextTertiaryBrush}" />
                    <TextBlock x:Name="TxtQualityVal" Text="92%" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" />
                </Grid>
                <Slider x:Name="SliderQuality" Minimum="10" Maximum="100" Value="92" Style="{StaticResource IOS7SliderStyle}" ValueChanged="SliderQuality_ValueChanged" />
            </StackPanel>

            <Border Background="{StaticResource ThemeCardBrush}" CornerRadius="10" BorderBrush="{StaticResource ThemeHairlineBrush}" BorderThickness="0.5" Padding="12">
                <Grid>
                    <TextBlock Text="Output Dimensions" Foreground="{StaticResource ThemeTextSecondaryBrush}" FontSize="12" />
                    <TextBlock x:Name="TxtDimensions" Text="1920 × 1080 px" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="12" />
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource IOS7BorderlessButtonStyle}" Click="Cancel_Click" Margin="0,0,10,0" />
            <Button Content="Export Image" Style="{StaticResource IOS7PrimaryButtonStyle}" Click="Export_Click" />
        </StackPanel>
    </Grid>
</Window>
