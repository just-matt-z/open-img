<Window x:Class="OpenImage.Dialogs.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Studio" 
        Height="540" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource ThemeBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="iOS 7 Color Studio" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />

        <!-- Main Content -->
        <StackPanel Grid.Row="1">
            <!-- Color Preview Block -->
            <Border CornerRadius="12" BorderBrush="{StaticResource ThemeHairlineBrush}" BorderThickness="0.5" Height="54" Margin="0,0,0,16" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Current Selected Color -->
                    <Border x:Name="CurrentColorTile" Grid.Column="0" Background="#007AFF">
                        <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" />
                    </Border>
                    <!-- Previous / Initial Color -->
                    <Border x:Name="InitialColorTile" Grid.Column="1" Background="#007AFF" MouseDown="InitialColor_Click" Cursor="Hand">
                        <TextBlock Text="ORIGINAL (RESET)" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" />
                    </Border>
                </Grid>
            </Border>

            <!-- RGB Sliders -->
            <Border Background="{StaticResource ThemeCardBrush}" CornerRadius="12" BorderBrush="{StaticResource ThemeHairlineBrush}" BorderThickness="0.5" Padding="14,10" Margin="0,0,0,14">
                <StackPanel>
                    <!-- Red -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="R" FontWeight="Bold" Foreground="#FF3B30" VerticalAlignment="Center" />
                        <Slider x:Name="SliderR" Grid.Column="1" Minimum="0" Maximum="255" Style="{StaticResource IOS7SliderStyle}" ValueChanged="Slider_ValueChanged" />
                        <TextBlock x:Name="TxtValR" Grid.Column="2" Text="0" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Green -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="G" FontWeight="Bold" Foreground="#34C759" VerticalAlignment="Center" />
                        <Slider x:Name="SliderG" Grid.Column="1" Minimum="0" Maximum="255" Style="{StaticResource IOS7SliderStyle}" ValueChanged="Slider_ValueChanged" />
                        <TextBlock x:Name="TxtValG" Grid.Column="2" Text="122" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Blue -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="B" FontWeight="Bold" Foreground="#007AFF" VerticalAlignment="Center" />
                        <Slider x:Name="SliderB" Grid.Column="1" Minimum="0" Maximum="255" Style="{StaticResource IOS7SliderStyle}" ValueChanged="Slider_ValueChanged" />
                        <TextBlock x:Name="TxtValB" Grid.Column="2" Text="255" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Hex Input -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HEX" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeTextTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtHex" Grid.Column="1" Text="#007AFF" FontSize="13" FontWeight="SemiBold" Padding="8,4" Background="White" BorderBrush="{StaticResource ThemeHairlineBrush}" BorderThickness="0.5" TextChanged="TxtHex_TextChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Curated iOS 7 Palette Swatches -->
            <TextBlock Text="IOS 7 SYSTEM PALETTE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeTextTertiaryBrush}" Margin="0,0,0,8" />
            <Border Background="{StaticResource ThemeCardBrush}" CornerRadius="12" BorderBrush="{StaticResource ThemeHairlineBrush}" BorderThickness="0.5" Padding="8" Margin="0,0,0,10">
                <WrapPanel HorizontalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#007AFF" Margin="4" Cursor="Hand" MouseDown="PaletteChip_Click" Tag="#007AFF" ToolTip="System Blue" />
                    <Border Width="36" Height="36" CornerRadius="8" Background="#5AC8FA" Margin="4" Cursor="Hand" MouseDown="PaletteChip_Click" Tag="#5AC8FA" ToolTip="System Teal" />
                    <Border Width="36" Height="36" CornerRadius="8" Background="#34C759" Margin="4" Cursor="Hand" MouseDown="PaletteChip_Click" Tag="#34C759" ToolTip="System Green" />
                    <Border Width="36" Height="36" CornerRadius="8" Background="#4CD964" Margin="4" Cursor="Hand" MouseDown="PaletteChip_Click" Tag="#4CD964" ToolTip="Mint" />
                    <Border Width="36" Height="36" CornerRadius="8" Background="#FFCC00" Margin="4" Cursor="Hand" MouseDown="PaletteChip_Click" Tag="#FFCC00" ToolTip="System Yellow" />
                    <Border Width="36" Height="36" CornerRadius="8" Background="#FF9500" Margin="4" Cursor="Hand" MouseDown="PaletteChip_Click" Tag="#FF9500" ToolTip="System Orange" />
                    <Border Width="36" Height="36" CornerRadius="8" Background="#FF3B30" Margin="4" Cursor="Hand" MouseDown="PaletteChip_Click" Tag="#FF3B30" ToolTip="System Red" />
                    <Border Width="36" Height="36" CornerRadius="8" Background="#FF2D55" Margin="4" Cursor="Hand" MouseDown="PaletteChip_Click" Tag="#FF2D55" ToolTip="System Pink" />
                    <Border Width="36" Height="36" CornerRadius="8" Background="#AF52DE" Margin="4" Cursor="Hand" MouseDown="PaletteChip_Click" Tag="#AF52DE" ToolTip="System Purple" />
                    <Border Width="36" Height="36" CornerRadius="8" Background="#5856D6" Margin="4" Cursor="Hand" MouseDown="PaletteChip_Click" Tag="#5856D6" ToolTip="Indigo" />
                    <Border Width="36" Height="36" CornerRadius="8" Background="#A2845E" Margin="4" Cursor="Hand" MouseDown="PaletteChip_Click" Tag="#A2845E" ToolTip="Warm Bronze" />
                    <Border Width="36" Height="36" CornerRadius="8" Background="#8E8E93" Margin="4" Cursor="Hand" MouseDown="PaletteChip_Click" Tag="#8E8E93" ToolTip="System Gray" />
                    <Border Width="36" Height="36" CornerRadius="8" Background="#E5E5EA" Margin="4" Cursor="Hand" MouseDown="PaletteChip_Click" Tag="#E5E5EA" ToolTip="Light Gray" />
                    <Border Width="36" Height="36" CornerRadius="8" Background="#1C1C1E" Margin="4" Cursor="Hand" MouseDown="PaletteChip_Click" Tag="#1C1C1E" ToolTip="Dark Elevated" />
                    <Border Width="36" Height="36" CornerRadius="8" Background="#000000" Margin="4" Cursor="Hand" MouseDown="PaletteChip_Click" Tag="#000000" ToolTip="Pure Black" />
                    <Border Width="36" Height="36" CornerRadius="8" Background="#FFFFFF" BorderBrush="#33000000" BorderThickness="1" Margin="4" Cursor="Hand" MouseDown="PaletteChip_Click" Tag="#FFFFFF" ToolTip="Pure White" />
                </WrapPanel>
            </Border>
        </StackPanel>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource IOS7DestructiveButtonStyle}" Click="Cancel_Click" Margin="0,0,10,0" Width="80" />
            <Button Content="Apply Color" Style="{StaticResource IOS7PrimaryButtonStyle}" Click="Apply_Click" Width="100" />
        </StackPanel>
    </Grid>
</Window>
