<Window x:Class="OpenImage.Dialogs.NewCanvasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Artwork Canvas" 
        Height="420" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource ThemeBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <TextBlock Text="New Artwork Canvas" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />

        <!-- Form Fields -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="PRESETS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeTextTertiaryBrush}" Margin="0,0,0,6" />
            <Border Background="{StaticResource ThemeCardBrush}" CornerRadius="10" BorderBrush="{StaticResource ThemeHairlineBrush}" BorderThickness="0.5" Padding="8" Margin="0,0,0,16">
                <WrapPanel>
                    <Button Content="Full HD (1920×1080)" Style="{StaticResource IOS7BorderlessButtonStyle}" Margin="2" Click="PresetFHD_Click" />
                    <Button Content="4K UHD (3840×2160)" Style="{StaticResource IOS7BorderlessButtonStyle}" Margin="2" Click="Preset4K_Click" />
                    <Button Content="Square (1080×1080)" Style="{StaticResource IOS7BorderlessButtonStyle}" Margin="2" Click="PresetSquare_Click" />
                    <Button Content="Story (1080×1920)" Style="{StaticResource IOS7BorderlessButtonStyle}" Margin="2" Click="PresetStory_Click" />
                    <Button Content="Wallpaper (2560×1440)" Style="{StaticResource IOS7BorderlessButtonStyle}" Margin="2" Click="PresetWallpaper_Click" />
                </WrapPanel>
            </Border>

            <!-- Custom Dimensions -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="WIDTH (PX)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeTextTertiaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtWidth" Text="1920" FontSize="14" Padding="10,6" Background="{StaticResource ThemeCardBrush}" BorderBrush="{StaticResource ThemeHairlineBrush}" BorderThickness="0.5" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="HEIGHT (PX)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeTextTertiaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtHeight" Text="1080" FontSize="14" Padding="10,6" Background="{StaticResource ThemeCardBrush}" BorderBrush="{StaticResource ThemeHairlineBrush}" BorderThickness="0.5" />
                </StackPanel>
            </Grid>

            <!-- Background Fill -->
            <TextBlock Text="CANVAS BACKGROUND" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeTextTertiaryBrush}" Margin="0,0,0,6" />
            <Border Background="{StaticResource ThemeCardBrush}" CornerRadius="10" BorderBrush="{StaticResource ThemeHairlineBrush}" BorderThickness="0.5" Padding="6" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton x:Name="RbWhite" Content="White" Style="{StaticResource IOS7SegmentedButtonStyle}" IsChecked="True" Margin="4,0" />
                    <RadioButton x:Name="RbTransparent" Content="Transparent" Style="{StaticResource IOS7SegmentedButtonStyle}" Margin="4,0" />
                    <RadioButton x:Name="RbDark" Content="Dark Studio" Style="{StaticResource IOS7SegmentedButtonStyle}" Margin="4,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource IOS7BorderlessButtonStyle}" Click="Cancel_Click" Margin="0,0,10,0" />
            <Button Content="Create Canvas" Style="{StaticResource IOS7PrimaryButtonStyle}" Click="Create_Click" />
        </StackPanel>
    </Grid>
</Window>
